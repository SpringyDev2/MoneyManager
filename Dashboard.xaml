<Window x:Class="MoneyManager.Dashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MoneyManager"
        mc:Ignorable="d"
        Title="Dashboard"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1E1E2F">
        
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Margin="15,15,0,15" CornerRadius="15" Padding="10" Background="#545454">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Button Click="LogoButton_Click" Background="Transparent" BorderThickness="0" Padding="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter/>
                        </ControlTemplate>
                    </Button.Template>
                    <Border Grid.Row="0"
                        Width="150"
                        Height="102"
                        Background="White"
                        CornerRadius="15"
                        Padding="10"
                        Margin="0,0,0,15">

                        <StackPanel x:Name="logoAndNamePanel" HorizontalAlignment="Center">
                            <!--<Image Source="pack://application:,,,/Resources/logo_mashov_students_project.png"
                                   Width="60"
                                   Height="60"
                                   Margin="0,0,0,5"/>-->
                            <TextBlock Text="Money Manager"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="Black"
                                   HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Button>
                <StackPanel Grid.Row="1">
                    <Button Background="Transparent" BorderThickness="0" HorizontalAlignment="Center" VerticalAlignment="Center" Click="Profile_Btn_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Button.Template>
                        <Border Background="#337ab7" CornerRadius="15" Width="170" Height="100" Margin="0,0,0,15">
                            <TextBlock Text="Personal Information" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                        </Border>
                    </Button>
                    <Button Background="Transparent" BorderThickness="0" HorizontalAlignment="Center" VerticalAlignment="Center" Click="Transactions_Btn_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Button.Template>
                        <Border Background="#f04c4c" CornerRadius="15" Width="170" Height="100" Margin="0,0,0,15">
                            <TextBlock Text="Transactions" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                        </Border>
                    </Button>
                    <Button Background="Transparent" BorderThickness="0" HorizontalAlignment="Center" VerticalAlignment="Center" Click="Teachers_Btn_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Button.Template>
                        <Border Background="#60a873" CornerRadius="15" Width="170" Height="100" Margin="0,0,0,15">
                            <TextBlock Text="Statistics" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                        </Border>
                    </Button>
                </StackPanel>
                <Button Background="Transparent" BorderThickness="0" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="2" Click="LogoutBtnClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter/>
                        </ControlTemplate>
                    </Button.Template>
                    <Border Background="#196638" CornerRadius="15" Width="100" Height="50" Margin="0,15,0,15">
                        <TextBlock Text="Log out" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                </Button>
            </Grid>
        </Border>
        <Frame x:Name="MainFrame" Grid.Column="1" NavigationUIVisibility="Hidden" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
    </Grid>
</Window>
