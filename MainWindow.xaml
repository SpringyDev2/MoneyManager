<Window x:Class="MoneyManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MoneyManager"
        mc:Ignorable="d"
        Title="Login"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1E1E2F">
    <Grid>
        <Border Width="550"
                Height="420"
                Background="White"
                CornerRadius="20"
                Padding="30"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

            <StackPanel>
                <!-- Title -->
                <StackPanel x:Name="logoAndNamePanel">
                    <!--<Image Source="pack://application:,,,/Resources/logo_mashov_students_project.png"
                    Width="60"
                    Height="60"
                    Margin="0,0,0,0"/>-->
                    <TextBlock Text="Money Manager"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="#333"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>
                </StackPanel>
                <StackPanel x:Name="LoginUserPasswordButtonPanel">
                    <!-- Username -->
                    <TextBlock Text="Username (Id)"
                           FontSize="14"
                           Foreground="Gray"
                           Margin="0,0,0,5"/>

                    <TextBox x:Name="txtUsername"
                         Height="50"
                         FontSize="16"
                         Padding="10"
                         BorderThickness="1"
                         BorderBrush="#CCCCCC"
                         Margin="0,0,0,5"/>

                    <!-- Password -->
                    <TextBlock Text="Password"
                           FontSize="14"
                           Foreground="Gray"
                           Margin="0,0,0,5"/>

                    <PasswordBox x:Name="txtPassword"
                             Height="50"
                             FontSize="16"
                             Padding="10"
                             BorderThickness="1"
                             BorderBrush="#CCCCCC"
                             Margin="0,0,0,30"/>

                    <!-- Login Button -->
                    <Button Content="Login"
                        Height="45"
                        FontSize="16"
                        FontWeight="Bold"
                        Background="#71509b"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="LoginButton_Click"/>
                </StackPanel>
                <TextBlock x:Name="LoginSuccessMsg" Text="Logged in successfully" Height="40" FontSize="16" Padding="10" TextAlignment="Center" Visibility="Collapsed" FontWeight="Bold" Foreground="#333"/>
                <TextBlock x:Name="LoginFailMsg" Text="Wrong Credentials" Height="40" FontSize="16" Padding="10" TextAlignment="Center" Visibility="Collapsed" FontWeight="Bold" Foreground="#333"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
