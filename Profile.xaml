<Page x:Class="MoneyManager.Profile"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MoneyManager"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Profile">

    <Page.Resources>

        <!-- Labels -->
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="45"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="white"/>
        </Style>

        <!-- TextBoxes -->
        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="Width" Value="600"/>
            <Setter Property="Height" Value="80"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="BorderBrush" Value="#B0B0B0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="45"/>
        </Style>

        <!-- Buttons -->
        <Style x:Key="FormButton" TargetType="Button">
            <Setter Property="Width" Value="360"/>
            <Setter Property="Height" Value="128"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Background" Value="#2D89EF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Page.Resources>
    <Grid Background="#1E1E2F">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="15*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Row="0" Background="White" CornerRadius="15" Padding="10" Margin="15,15,0,0" VerticalAlignment="Top" HorizontalAlignment="Left">
            <!--<Image Source="pack://application:,,,/Resources/Google_Contacts_logo.png" Width="60" Height="60" />-->
        </Border>
        <Grid Margin="20" Grid.Column="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>
            <!-- Labels -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Username:" Style="{StaticResource FormLabel}"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Password:" Style="{StaticResource FormLabel}"/>

            <TextBox Grid.Row="0" Grid.Column="1"
                 Name="UsernameBox"
                 HorizontalAlignment="Left"        
                 Text="{Binding Username, Mode=TwoWay}"
                 Style="{StaticResource FormTextBox}"/>

            <TextBox Grid.Row="1" Grid.Column="1"
                 Name="PasswordBox"
                 HorizontalAlignment="Left"
                 Text="{Binding Password, Mode=TwoWay}"
                 Style="{StaticResource FormTextBox}"/>

            <!-- BUTTONS -->
            <StackPanel Grid.Row="7" Grid.Column="1"
                Orientation="Horizontal"
                HorizontalAlignment="Left"
                Margin="100,0,0,0"
                VerticalAlignment="Top">
                <Button Content="Confirm Changes"
                Style="{StaticResource FormButton}"
                Background="#7266ba"
                Click="ConfirmChangesBtnClick"
                />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
